# Database configuration
# For local zero-config testing: file:./dev.db
# For PostgreSQL production: postgresql://USER:PASSWORD@localhost:5432/unidesk?schema=public
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT / Session tokens
SESSION_SECRET="unidesk-super-secure-jwt-session-secret-key-32chars-min"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Abstraction: Console Logger in dev, SMTP in prod)
EMAIL_PROVIDER="console" # "console" | "smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UniDesk Notifications <no-reply@unidesk.edu>"

# Escalation Engine SLA Defaults (hours)
SLA_LOW_HOURS="72"
SLA_MEDIUM_HOURS="48"
SLA_HIGH_HOURS="24"
SLA_URGENT_HOURS="12"
